{
  "installCommand": "npm install --global bun@1.4.0 && cd ../.. && bun install --frozen-lockfile",
  "buildCommand": "DRAUPNIR_WORKSPACE_ROOT=\"$(cd ../.. && pwd)\" bun run build",
  "crons": [
    {
      "path": "/api/cron/deploy",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/swipe-rank",
      "schedule": "30 6 1 * *"
    },
    {
      "path": "/api/cron/swipe-rank-review",
      "schedule": "15 7 1 * *"
    },
    {
      "path": "/api/cron/transient-uploads",
      "schedule": "15 * * * *"
    }
  ]
}
