{
  "name": "@swipestats/web",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "velite build && next build",
    "postinstall": "velite build",
    "check": "bun copy:check && bun db:check && velite build && eslint . && tsc --noEmit && bun test",
    "copy:check": "bun src/scripts/check-copy-style.ts",
    "clean": "rm -rf node_modules .next .turbo .cache .velite .eslintcache bun.lock",
    "reinstall": "bun run clean && bun install",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check --dialect=postgresql --out=drizzle",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "echo \"Use generated migrations for this experiment\" && exit 1",
    "db:studio": "drizzle-kit studio",
    "db:seed:catalog": "bun src/scripts/seed-dating-services.ts",
    "db:seed:catalog:preview": "bun src/scripts/seed-dating-services.ts --include-preview-fixtures",
    "data-layer:audit-cohorts": "bun run src/scripts/data-layer/audit-cohort-retirement.ts",
    "data-layer:audit-descriptors": "bun run src/scripts/data-layer/audit-descriptor-coverage.ts",
    "data-layer:audit-hinge-over-100": "bun run src/scripts/data-layer/audit-hinge-over-100.ts",
    "data-layer:audit-hinge-like-links": "bun run src/scripts/data-layer/audit-hinge-like-link-collisions.ts",
    "data-layer:audit-profile-meta": "bun run src/scripts/data-layer/audit-profile-meta.ts",
    "data-layer:audit-upload-vintage": "bun run src/scripts/data-layer/audit-upload-vintage.ts",
    "data-layer:cleanup-transient-uploads": "bun run src/scripts/data-layer/cleanup-transient-uploads.ts",
    "data-layer:inspect-periods": "bun run src/scripts/data-layer/inspect-period-layer.ts",
    "data-layer:investigate-hinge-like-lineage": "bun run src/scripts/data-layer/investigate-hinge-like-link-lineage.ts",
    "data-layer:probe-cohort": "bun run src/scripts/data-layer/probe-dynamic-cohort.ts",
    "data-layer:repair-conversations": "bun run src/scripts/data-layer/repair-conversation-metrics.ts",
    "data-layer:repair-hinge-media": "bun run src/scripts/data-layer/repair-hinge-media-duplicates.ts",
    "data-layer:repair-profile-meta": "bun run src/scripts/data-layer/repair-profile-meta.ts",
    "data-layer:repair-tinder-dates": "bun run src/scripts/data-layer/repair-tinder-calendar-dates.ts",
    "dev": "portless",
    "dev:direct": "next dev --turbopack",
    "dev:webpack": "next dev --webpack",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx,json}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx,json}\" --cache",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix --cache",
    "ls:overview": "bun run src/scripts/lemonsqueezy/overview.ts",
    "locations:extract": "bun run src/scripts/llm-analysis/extract-locations-v2.ts",
    "privacy:anonymize-image": "bun run src/scripts/llm-analysis/anonymize-image-online.ts",
    "privacy:anonymize-swiperank": "bun run src/scripts/llm-analysis/anonymize-swipe-rank-images.ts",
    "privacy:audit-swiperank-codex": "bun run src/scripts/llm-analysis/audit-swipe-rank-images-with-codex.ts",
    "preview": "next build && next start",
    "start": "next start",
    "swipe-rank:audit-over-100": "bun run src/scripts/swipe-rank/audit-over-100.ts",
    "swipe-rank:inspect-facts": "bun run src/scripts/swipe-rank/inspect-profile-facts.ts",
    "swipe-rank:moderate": "bun run src/scripts/swipe-rank/moderate-profile.ts",
    "swipe-rank:publish": "bun run src/scripts/swipe-rank/publish-previous-month.ts",
    "swipe-rank:review": "bun run src/scripts/swipe-rank/review-cohort.ts",
    "swipe-rank:review-codex": "bun run src/scripts/swipe-rank/review-local-codex.ts",
    "swipe-rank:validate": "bun run src/scripts/swipe-rank/validate-period-facts.ts",
    "test": "bun test",
    "typecheck": "velite build && tsc --noEmit",
    "velite:build": "velite build",
    "velite:dev": "velite --watch",
    "email:dev": "email dev",
    "amplitude:sync-taxonomy": "bun src/scripts/sync-amplitude-taxonomy.ts",
    "data-layer:rekey-hinge-profiles": "bun run src/scripts/data-layer/rekey-hinge-profiles.ts",
    "test:tinder:postgres": "bun scripts/test-tinder-ownership-postgres.ts",
    "test:hinge:postgres": "bun scripts/test-hinge-ownership-postgres.ts",
    "privacy:benchmark-text-codex": "bun run src/scripts/llm-analysis/benchmark-text-codex.ts",
    "privacy:research-text": "bun run src/scripts/llm-analysis/process-research-text.ts"
  },
  "portless": {
    "name": "swipestats",
    "script": "dev:direct"
  },
